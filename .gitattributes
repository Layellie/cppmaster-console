# Normalize line endings in the repository to LF, so a Windows and a
# Linux contributor don't produce whole-file diffs against each other.
# Working copies still get native endings on checkout.
* text=auto eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# Explicitly binary, never munge.
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.lib binary
*.pdb binary
