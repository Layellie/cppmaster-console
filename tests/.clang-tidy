# Test-only relaxations. Inherits everything from the root .clang-tidy and
# only turns off what the test framework itself makes unprovable.
InheritParentConfig: true

# - bugprone-unchecked-optional-access: tests consistently write
#   CHECK(candidate.has_value()) before dereferencing, but CHECK is this
#   project's own macro, so clang-tidy cannot see that it guarantees the
#   value and reports every following `->` as unchecked. It produced 222
#   findings here and zero in src/, where the check is genuinely valuable
#   and stays enabled.
# - misc-const-correctness: 185 of its 186 findings were test locals. The
#   one in src/ was fixed rather than suppressed.
# - misc-use-internal-linkage / bugprone-throwing-static-initialization:
#   TEST_CASE defines a free function and a static registrar object per test.
# - bugprone-random-generator-seed: unit tests deliberately use fixed seeds
#   for deterministic, reproducible generator runs.
# - readability-identifier-naming: TEST_CASE(Suite_Scenario) expands to free
#   functions using PascalCase_PascalCase across the test suite, which
#   clang-tidy-21 flags through the macro; src/ keeps full naming checks.
Checks: >
  -bugprone-unchecked-optional-access,
  -bugprone-throwing-static-initialization,
  -bugprone-random-generator-seed,
  -misc-const-correctness,
  -misc-use-internal-linkage,
  -readability-identifier-naming
