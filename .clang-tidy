# Checks are opt-in rather than "everything minus exclusions", so the set
# stays readable and every enabled family is here on purpose.
#
# Deliberately NOT enabled:
#   - readability-magic-numbers / cppcoreguidelines-avoid-magic-numbers:
#     the question and lesson content files are thousands of literal
#     values by nature; the signal-to-noise ratio would be hopeless.
#   - modernize-use-trailing-return-type: purely stylistic, and contrary
#     to how this codebase is written.
#   - llvmlibc-*, fuchsia-*, altera-*: vendor-specific rules irrelevant here.
#   - misc-include-cleaner: an include-what-you-use style rule that flags
#     every transitively-provided symbol. It reported 312 findings, nearly
#     all of them standard-library symbols reached through headers this
#     project includes on purpose; acting on them would mean churning
#     every file's include block for no correctness gain.
#   - performance-enum-size: suggests narrower underlying types for enums.
#     These enums are passed around as single values, never packed into
#     large arrays, so the saving is theoretical while the readability
#     cost is real.
#   - readability-convert-member-functions-to-static: fires on ConsoleUI's
#     output methods, which do not touch members today. They are instance
#     methods deliberately — ConsoleUI models an output device, and making
#     them static would block the dependency injection needed to test
#     Application against a fake console.
# Order matters: clang-tidy applies these left to right, so every negation
# must come AFTER the wildcard that would otherwise enable it.
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  performance-*,
  -performance-enum-size,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements,
  -readability-uppercase-literal-suffix,
  -readability-convert-member-functions-to-static

# Warnings become errors in CI so a regression can't be merged unnoticed;
# see .github/workflows/ci.yml.
WarningsAsErrors: ''

HeaderFilterRegex: '^.*/src/.*\.h$'

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
