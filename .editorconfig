root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown (line break).
trim_trailing_whitespace = false

[*.ps1]
# PowerShell tooling on Windows defaults to CRLF; keep it consistent.
end_of_line = crlf
